{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/renderer/*"] }
  },
  "include": ["src/renderer", "packages/sdk/src/contracts.ts", "packages/sdk/src/renderer.ts", "src/shared", "src/modules/*/renderer.tsx"]
}
