{
  "name": "atelier",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "A local-first AI workshop for agents, resources, and work in progress",
  "author": "Chien Zhang",
  "main": "dist/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "install-electron && node scripts/prepare-native.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "i18n:extract": "node scripts/i18n.ts extract",
    "i18n:check": "node scripts/i18n.ts check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/openai": "4.0.91",
    "@atelier/builtin": "^0.1.0",
    "@atelier/builtin-api": "^0.14.0",
    "@atelier/sdk": "^0.38.0",
    "@atelier/ui": "^0.1.0",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@formatjs/intl": "6.1.3",
    "@formatjs/intl-localematcher": "0.9.0",
    "@lobehub/streamdown": "1.4.1",
    "@opencode-ai/models": "0.0.104",
    "@pierre/diffs": "1.5.2",
    "@pierre/trees": "^1.0.0-beta.6",
    "@radix-ui/colors": "3.0.0",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.137",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "electron-store": "11.0.2",
    "esbuild": "0.28.2",
    "katex": "0.16.47",
    "lucide-react": "1.55.0",
    "mermaid": "12.2.0",
    "motion": "14.1.0",
    "nanoid": "6.0.2",
    "partial-json": "0.1.7",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "semver": "7.8.5",
    "shell-env": "4.0.3",
    "simple-git": "^4.0.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@formatjs/cli": "6.16.34",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-vite": "6.0.0-beta.8",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron@44.7.0": true
