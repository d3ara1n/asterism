{
  "name": "asterism",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "A local-first AI workbench for agents, resources, and work in progress",
  "author": "Chien Zhang",
  "main": "dist/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "install-electron && node scripts/prepare-native.mjs && node scripts/prepare-signing.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --config electron-builder.config.ts --dir --publish never",
    "make": "npm run build && electron-builder --config electron-builder.config.ts --publish never",
    "i18n:extract": "node scripts/i18n.ts extract",
    "i18n:check": "node scripts/i18n.ts check",
    "icon": "node scripts/app-icon.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/openai": "4.0.104",
    "@asterism-app/builtin": "*",
    "@asterism-app/builtin-api": "*",
    "@asterism-app/sdk": "*",
    "@asterism-app/ui": "*",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@formatjs/intl": "6.1.4",
    "@formatjs/intl-localematcher": "0.9.0",
    "@lobehub/streamdown": "1.4.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@opencode-ai/models": "0.0.119",
    "@pierre/diffs": "1.6.2",
    "@pierre/trees": "^1.0.0-beta.6",
    "@radix-ui/colors": "3.0.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.156",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "electron-store": "12.0.0",
    "electron-updater": "6.8.11",
    "elkjs": "0.12.1",
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "lucide-react": "1.64.0",
    "mermaid": "12.2.0",
    "motion": "14.7.1",
    "nanoid": "6.0.2",
    "node-pty": "1.1.0",
    "partial-json": "0.1.7",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.6",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "semver": "7.8.5",
    "shell-env": "4.0.3",
    "simple-git": "^4.0.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "undici": "7.30.1",
    "virtua": "0.54.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@formatjs/cli": "6.16.36",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@lobehub/streamdown": {
      "katex": "$katex"
    },
    "@pierre/trees": {
      "@pierre/theming": "1.0.2"
    },
    "mermaid": {
      "katex": "$katex"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    },
    "rehype-katex": {
      "katex": "$katex"
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron@45.1.0": true
  }
}
