---
import Glyph from "./Glyph.astro";
import Mark from "./Mark.astro";
import { content, releasesUrl, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].download;
const quarantineCmd = "xattr -dr com.apple.quarantine /Applications/Asterism.app";
---

<section id="download" class="download">
  <div class="wrap">
    <div class="top">
      <Mark size={52} class="mark" />
      <h2>{t.title}</h2>
    </div>

    <ul class="platforms" data-platforms>
      {
        t.platforms.map(platform => (
          <li class="platform-item" data-os={platform.id}>
            <a class="platform-main" href={`${releasesUrl}/latest/download/${platform.asset}`}>
              <span class="os-row">
                <span class="os">{platform.os}</span>
                <span class="rec" data-rec hidden>{t.recommended}</span>
              </span>
              <span class="detail">
                {platform.arch} <span class="type">{platform.type}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="foot">
      <details class="quarantine">
        <summary>{t.quarantine.summary}</summary>
        <p>{t.quarantine.body}</p>
        <div class="code-box">
          <pre><code>{quarantineCmd}</code></pre>
          <button
            type="button"
            class="copy-btn"
            data-copy={quarantineCmd}
            data-label-copy={t.copy}
            data-label-copied={t.copied}
          >
            <span class="icon-copy"><Glyph name="copy" /></span>
            <span class="icon-check" hidden><Glyph name="check" /></span>
            <span data-copy-text>{t.copy}</span>
          </button>
        </div>
      </details>
      <a class="all" href={releasesUrl}>{t.all}</a>
    </div>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>("[data-platforms]");

  // Highlight the visitor's likely platform without hiding the others.
  const ua = navigator.userAgent.toLowerCase();
  const detected = ua.includes("mac") ? "mac" : ua.includes("win") ? "win" : ua.includes("linux") ? "linux" : null;
  if (detected && list) {
    const item = list.querySelector<HTMLElement>(`[data-os="${detected}"]`);
    const badge = item?.querySelector<HTMLElement>("[data-rec]");
    item?.classList.add("is-detected");
    if (badge) badge.hidden = false;
  }

  // Copy helper for the macOS quarantine command.
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]");
  if (copyBtn) {
    let timer = 0;
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.copy!);
        const text = copyBtn.querySelector<HTMLElement>("[data-copy-text]");
        const iconCopy = copyBtn.querySelector<HTMLElement>(".icon-copy");
        const iconCheck = copyBtn.querySelector<HTMLElement>(".icon-check");
        if (text) text.textContent = copyBtn.dataset.labelCopied!;
        if (iconCopy) iconCopy.hidden = true;
        if (iconCheck) iconCheck.hidden = false;
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (text) text.textContent = copyBtn.dataset.labelCopy!;
          if (iconCopy) iconCopy.hidden = false;
          if (iconCheck) iconCheck.hidden = true;
        }, 1800);
      } catch {
        // Leave the selectable code block for manual copy if clipboard access is denied.
      }
    });
  }
</script>

<style>
  .download {
    background: var(--ink);
    color: var(--bg);
    padding-block: clamp(5rem, 11vw, 9rem) 3rem;

    --line-inv: color-mix(in srgb, var(--bg) 18%, transparent);
    --ink-inv: color-mix(in srgb, var(--bg) 64%, transparent);
  }

  .top {
    display: grid;
    justify-items: start;
    gap: 1.4rem;
  }

  .top :global(.mark) {
    opacity: 0.92;
  }

  h2 {
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    line-height: 0.95;
    font-weight: 300;
    font-stretch: 120%;
    letter-spacing: -0.045em;
  }

  :global(html:lang(zh)) h2 {
    letter-spacing: 0;
    font-stretch: 100%;
  }

  .platforms {
    list-style: none;
    margin: clamp(3rem, 6.5vw, 4.75rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-inv);
  }

  .platform-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .platform-item + .platform-item {
    border-left: 1px solid var(--line-inv);
  }

  .platform-main {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
    padding: 1.75rem 1.5rem 1.75rem 0;
    transition: background-color 0.25s, padding 0.35s var(--ease);
  }

  .platform-item + .platform-item .platform-main {
    padding-left: 1.5rem;
  }

  .platform-main:hover {
    background: color-mix(in srgb, var(--bg) 6%, transparent);
    padding-left: 1.5rem;
  }

  .os-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .os {
    font-size: 1.5rem;
    font-weight: 420;
    font-stretch: 110%;
    letter-spacing: -0.015em;
  }

  .rec {
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 13%, transparent);
    color: var(--bg);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .detail {
    font-size: 0.875rem;
    color: var(--ink-inv);
  }

  .type {
    margin-left: 0.35rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-inv);
    font-size: 0.875rem;
    color: var(--ink-inv);
  }

  .quarantine {
    min-width: 0;
    max-width: 100%;
  }

  summary {
    cursor: pointer;
    list-style: none;
    transition: color 0.2s;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    display: inline-block;
    margin-left: 0.5rem;
    transition: rotate 0.3s var(--ease);
  }

  details[open] summary::after {
    rotate: 45deg;
  }

  summary:hover,
  .all:hover {
    color: var(--bg);
  }

  details p {
    margin-top: 0.9rem;
    max-width: 36em;
    text-wrap: pretty;
  }

  .code-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0.5rem 0.55rem 0.5rem 0.9rem;
    border: 1px solid var(--line-inv);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--bg) 4%, transparent);
    max-width: 100%;
  }

  pre {
    margin: 0;
    flex: 1;
    overflow-x: auto;
    color: var(--bg);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line-inv);
    border-radius: 0.45rem;
    background: transparent;
    color: var(--ink-inv);
    font-size: 0.75rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }

  .copy-btn:hover {
    color: var(--bg);
    border-color: color-mix(in srgb, var(--bg) 45%, transparent);
    background: color-mix(in srgb, var(--bg) 7%, transparent);
  }

  .copy-btn span[hidden] {
    display: none;
  }

  .all {
    flex: none;
    border-bottom: 1px solid var(--line-inv);
    padding-bottom: 0.12rem;
    transition: color 0.2s, border-color 0.2s;
  }

  .all:hover {
    border-color: var(--bg);
  }

  .download :global(:focus-visible) {
    outline-color: var(--bg);
  }

  @media (max-width: 52rem) {
    .platforms {
      grid-template-columns: 1fr;
    }

    .platform-item + .platform-item {
      border-left: 0;
      border-top: 1px solid var(--line-inv);
    }

    .platform-item + .platform-item .platform-main,
    .platform-main {
      padding-left: 0;
    }

    .foot {
      flex-direction: column;
    }

    .code-box {
      flex-wrap: wrap;
    }
  }
</style>
