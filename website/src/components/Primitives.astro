---
import Glyph from "./Glyph.astro";
import { content, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].primitives;
---

<section id="resources" class="primitives wrap">
  <div class="head">
    <h2>{t.title}</h2>
    <p>{t.body}</p>
  </div>

  <dl class="grid">
    {
      t.items.map(item => (
        <div class="cell">
          <dt>
            <Glyph name={item.glyph} />
            <span>{item.name}</span>
          </dt>
          <dd>{item.detail}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .primitives {
    padding-block: clamp(5rem, 10vw, 8.5rem);
    background: linear-gradient(var(--line), var(--line)) top center / calc(100% - var(--gutter) * 2) 1px no-repeat;
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 6vw, 6rem);
    align-items: end;
  }

  h2 {
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    line-height: 1.05;
    font-weight: 340;
    font-stretch: 110%;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  :global(html:lang(zh)) h2 {
    letter-spacing: 0;
    line-height: 1.24;
  }

  .head p {
    max-width: 28em;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(2.75rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .cell {
    padding: 1.75rem 1.75rem 1.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .cell:not(:nth-child(3n + 1)) {
    padding-left: 1.75rem;
    border-left: 1px solid var(--line);
  }

  .cell:nth-child(3n) {
    padding-right: 0;
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.0625rem;
    font-weight: 520;
    font-stretch: 105%;
    letter-spacing: -0.01em;
  }

  dt :global(.glyph) {
    color: var(--ink-2);
    flex: none;
  }

  dd {
    margin-top: 0.65rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    max-width: 24em;
    text-wrap: pretty;
  }

  @media (max-width: 60rem) {
    .head {
      grid-template-columns: 1fr;
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cell:not(:nth-child(3n + 1)) {
      padding-left: 0;
      border-left: 0;
    }

    .cell:nth-child(3n) {
      padding-right: 1.75rem;
    }

    .cell:nth-child(2n) {
      padding-left: 1.5rem;
      padding-right: 0;
      border-left: 1px solid var(--line);
    }
  }

  @media (max-width: 38rem) {
    .grid {
      grid-template-columns: 1fr;
    }

    .cell,
    .cell:nth-child(2n),
    .cell:nth-child(3n) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
