---
import Glyph from "./Glyph.astro";
import { content, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const m = t.story.mock;
const n = t.hero.nodes;
---

<section id="how-it-works" class="story wrap" aria-label={t.story.label}>
  <div class="stage" data-stage data-step="0">
    <!-- Steps 1–3: Embedded light-surface UI slice with feathered/blurred edges -->
    <div class="mock-viewport" aria-hidden="true">
      <div class="mock-aperture">
        <div class="mock-scene">
          <!--Workbench connection wires matching Asterism's LinkEdge (port dot + mid chevron + solid head)-->
          <svg class="mock-wires" viewBox="0 0 840 440">
            <defs>
              <marker id="mock-head" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M9 5 L1 1 Q3.2 5 1 9 Z" fill="#202020" />
              </marker>
            </defs>

            <!-- Directory -> Writer -->
            <g class="mwire mwire-access">
              <path class="mwire-path" d="M214 96 C 244 96, 238 118, 265 118" marker-end="url(#mock-head)" pathLength="1" />
              <circle class="mwire-dot" cx="214" cy="96" r="3" />
            </g>

            <!-- Note -> Writer -->
            <g class="mwire mwire-access mwire-delay">
              <path class="mwire-path" d="M214 236 C 244 236, 238 188, 265 188" marker-end="url(#mock-head)" pathLength="1" />
              <circle class="mwire-dot" cx="214" cy="236" r="3" />
            </g>

            <!-- Writer -> Reviewer (Step 3) -->
            <g class="mwire mwire-handoff">
              <path class="mwire-path" d="M518 164 C 546 164, 540 164, 565 164" marker-end="url(#mock-head)" pathLength="1" />
              <circle class="mwire-dot" cx="518" cy="164" r="3" />
            </g>

            <!-- Directory -> Reviewer verification link (Step 3) -->
            <g class="mwire mwire-handoff mwire-subtle">
              <path class="mwire-path" d="M214 68 C 360 22, 456 26, 565 106" marker-end="url(#mock-head)" pathLength="1" />
              <circle class="mwire-dot" cx="214" cy="68" r="2.6" />
            </g>
          </svg>

          <!-- Card 1: Directory (partially cropped at left edge for slice feel) -->
          <div class="mcard mcard-dir">
            <header class="mcard-head">
              <Glyph name="folder" />
              <span class="mkind">{m.kindDirectory}</span>
              <span class="mtitle">{n.folder.title}</span>
            </header>
            <div class="mcard-body mtree">
              <div class="mtree-row"><span class="mchev">▾</span> <span>src/</span></div>
              <div class="mtree-row mtree-indent"><span>session/fold.ts</span></div>
              <div class="mtree-row mtree-active"><span>CHANGELOG.md</span> <span class="mgit">M</span></div>
              <div class="mtree-row"><span>package.json</span></div>
            </div>
          </div>

          <!-- Card 2: Note -->
          <div class="mcard mcard-note">
            <header class="mcard-head">
              <Glyph name="note" />
              <span class="mkind">{m.kindNote}</span>
              <span class="mtitle">{m.noteTitle}</span>
            </header>
            <div class="mcard-body mnote">
              <div class="mnote-line"><span class="mbullet" /> {m.noteLine1}</div>
              <div class="mnote-line"><span class="mbullet" /> {m.noteLine2}</div>
            </div>
          </div>

          <!-- Card 3: Terminal (cropped at bottom-left, stays unlinked in step 2) -->
          <div class="mcard mcard-term">
            <header class="mcard-head">
              <Glyph name="terminal" />
              <span class="mkind">{m.kindTerminal}</span>
              <span class="mtitle">zsh</span>
              <span class="mbadge mbadge-unlinked">{m.unlinkedBadge}</span>
            </header>
            <div class="mcard-body mterm">
              <code>$ npm run build</code>
              <span class="mterm-dim">dist/ ready in 198ms</span>
            </div>
          </div>

          <!-- Card 4: Writer Agent -->
          <div class="mcard mcard-agent mcard-writer">
            <header class="mcard-head">
              <Glyph name="agent" />
              <span class="mkind">{m.kindAgent}</span>
              <span class="mtitle">{n.writer.title}</span>
              <span class="mbadge mbadge-ready">
                <span class="mdot" />
                <span class="mstatus-ready">{m.statusReady}</span>
                <span class="mstatus-work">{m.statusWorking}</span>
              </span>
            </header>
            <div class="mcard-body mconv">
              <div class="mmsg-user">{m.userPrompt}</div>

              <div class="mtool mtool-1">
                <span class="mtool-op">{m.toolRead}</span>
                <span class="mtool-sub">~/asterism</span>
                <span class="mtool-arg">CHANGELOG.md</span>
              </div>

              <div class="mtool mtool-2">
                <span class="mtool-op">{m.toolRead}</span>
                <span class="mtool-sub">{m.noteTitle}</span>
              </div>

              <div class="mmsg-agent">{m.writerDraft}</div>
            </div>
          </div>

          <!-- Card 5: Reviewer Agent (enters cleanly on Step 3 as camera pans) -->
          <div class="mcard mcard-agent mcard-reviewer">
            <header class="mcard-head">
              <Glyph name="agent" />
              <span class="mkind">{m.kindAgent}</span>
              <span class="mtitle">{n.reviewer.title}</span>
              <span class="mbadge mbadge-ready">
                <span class="mdot" />
                <span>{m.statusReady}</span>
              </span>
            </header>
            <div class="mcard-body mconv">
              <div class="mmsg-incoming">
                <div class="mincoming-head">
                  <Glyph name="agent" />
                  <span>{m.incomingFrom}</span>
                </div>
                <p>{m.incomingBody}</p>
              </div>

              <div class="mtool mtool-rev">
                <span class="mtool-op">{m.toolRead}</span>
                <span class="mtool-sub">~/asterism</span>
                <span class="mtool-arg">CHANGELOG.md</span>
              </div>

              <div class="mmsg-agent mmsg-rev">{m.reviewerReply}</div>
            </div>
          </div>
        </div>
      </div>
      <!-- Soft frosted rim blending the light UI slice into the ambient page -->
      <div class="mock-rim" />
    </div>

    <!-- Step 4: Pure abstract branching history tree -->
    <svg class="history-stage" viewBox="0 0 500 420" aria-hidden="true">
      <path class="trunk" d="M52 256 H440" pathLength="1" />
      <path class="branch" d="M216 256 C 270 256, 270 154, 326 154 H448" pathLength="1" />
      {[52, 134, 216, 328, 440].map(x => <circle class="commit" cx={x} cy="256" r="6.5" />)}
      <circle class="commit commit-pivot" cx="216" cy="256" r="6.5" />
      {[326, 388].map(x => <circle class="commit commit-branch" cx={x} cy="154" r="6.5" />)}
      <circle class="head" cx="448" cy="154" r="10" />

      <text class="history-caption" x="216" y="294">{t.story.historyLabels.earlier}</text>
      <text class="history-caption history-kept" x="440" y="294">{t.story.historyLabels.kept}</text>
      <text class="history-caption history-active" x="448" y="124">{t.story.historyLabels.branch}</text>
    </svg>
  </div>

  <ol class="steps">
    {
      t.story.steps.map((step, index) => (
        <li class:list={["step", { "is-active": index === 0 }]} data-step-index={index}>
          <button type="button" class="step-trigger" data-step-btn={index}>
            <span class="step-num">0{index + 1}</span>
            <h2>{step.title}</h2>
            <p>{step.body}</p>
          </button>
        </li>
      ))
    }
  </ol>
</section>

<script>
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const steps = [...document.querySelectorAll<HTMLElement>("[data-step-index]")];

  if (stage && steps.length) {
    const activate = (index: string) => {
      stage.dataset.step = index;
      steps.forEach(step => step.classList.toggle("is-active", step.dataset.stepIndex === index));
    };

    let observer: IntersectionObserver | null = null;
    const mq = matchMedia("(max-width: 56rem)");

    const setupObserver = () => {
      observer?.disconnect();
      const band = mq.matches ? "-60% 0px -24% 0px" : "-44% 0px -44% 0px";
      observer = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            activate((entry.target as HTMLElement).dataset.stepIndex!);
          }
        },
        { rootMargin: band },
      );
      steps.forEach(step => observer!.observe(step));
    };

    setupObserver();
    mq.addEventListener("change", setupObserver);

    steps.forEach(step => {
      const btn = step.querySelector<HTMLButtonElement>("[data-step-btn]");
      btn?.addEventListener("click", () => {
        const index = step.dataset.stepIndex!;
        activate(index);
        step.scrollIntoView({ behavior: "smooth", block: "center" });
      });
      btn?.addEventListener("focus", () => {
        activate(step.dataset.stepIndex!);
      });
    });
  }
</script>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(0, 0.94fr);
    gap: clamp(2rem, 5.5vw, 5.5rem);
    padding-block: clamp(5rem, 11vw, 9rem);
    background: linear-gradient(var(--line), var(--line)) top center / calc(100% - var(--gutter) * 2) 1px no-repeat;
  }

  .stage {
    position: sticky;
    top: calc(50vh - min(17.5rem, 36vw));
    align-self: start;
    aspect-ratio: 560 / 430;
    max-height: 35rem;
  }

  /* ==========================================================================
     Embedded Light-Mode Mock UI Viewport (Steps 0, 1, 2)
     Always rendered in Asterism's crisp daylight palette so it reads unmistakably
     as a cropped software surface embedded onto the fog/graphite page.
     ========================================================================== */
  .mock-viewport {
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    padding: 6px;
    background: color-mix(in srgb, #ffffff 42%, var(--surface));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.55) inset,
      0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent),
      0 24px 56px -28px rgb(16 19 22 / 0.28);
    transition: opacity 0.65s var(--ease), transform 0.65s var(--ease);
  }

  @media (prefers-color-scheme: dark) {
    .mock-viewport {
      background: rgb(255 255 255 / 0.08);
      box-shadow:
        0 1px 0 rgb(255 255 255 / 0.14) inset,
        0 0 0 1px rgb(255 255 255 / 0.08),
        0 28px 64px -26px rgb(0 0 0 / 0.72);
    }
  }

  .mock-aperture {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1.2rem;
    background-color: #f4f5f6;
    background-image: radial-gradient(circle, #d6dade 1px, transparent 1.2px);
    background-size: 18px 18px;
    color: #202020;
    /* Feathered partial-window crop around the edges */
    mask-image: radial-gradient(125% 120% at 50% 48%, #000 72%, rgb(0 0 0 / 0.88) 88%, rgb(0 0 0 / 0.35) 100%);
  }

  /* Subtle peripheral blur & vignette so cropped cards dissolve naturally at the frame edge */
  .mock-rim {
    position: absolute;
    inset: 6px;
    border-radius: 1.2rem;
    pointer-events: none;
    box-shadow:
      0 0 28px 10px rgb(244 245 246 / 0.78) inset,
      0 0 0 1px rgb(24 27 30 / 0.06) inset;
  }

  .mock-scene {
    position: absolute;
    top: 50%;
    left: 0;
    width: 840px;
    height: 440px;
    transform-origin: 0 50%;
    translate: 14px -50%;
    scale: var(--scene-scale, 0.96);
    transition: translate 0.85s var(--ease), scale 0.85s var(--ease);
  }

  /* Responsive internal scaling via container query */
  .stage {
    container-type: inline-size;
  }

  @container (max-width: 540px) {
    .mock-scene {
      --scene-scale: 0.82;
    }
  }

  @container (max-width: 440px) {
    .mock-scene {
      --scene-scale: 0.67;
    }
  }

  @container (max-width: 360px) {
    .mock-scene {
      --scene-scale: 0.56;
    }
  }

  /* Wires inside the mock scene */
  .mock-wires {
    position: absolute;
    inset: 0;
    width: 840px;
    height: 440px;
    overflow: visible;
    pointer-events: none;
    z-index: 2;
  }

  .mwire-path {
    fill: none;
    stroke: #202020;
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition: stroke-dashoffset 0.75s var(--ease), opacity 0.3s;
  }

  .mwire-dot {
    fill: #ffffff;
    stroke: #202020;
    stroke-width: 1.4;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .mwire-delay .mwire-path {
    transition-delay: 0.12s;
  }

  .mwire-subtle .mwire-path {
    stroke: #767c82;
    stroke-dasharray: 1;
  }

  /* Mock ObjectCards matching Asterism's real ObjectSurface */
  .mcard {
    position: absolute;
    background: #ffffff;
    border: 1px solid #dfe2e5;
    border-radius: 10px;
    box-shadow: 0 1px 2px rgb(16 19 22 / 0.04), 0 10px 24px -16px rgb(16 19 22 / 0.18);
    overflow: hidden;
    font-size: 12px;
    line-height: 1.4;
    transition:
      opacity 0.55s var(--ease),
      transform 0.75s var(--ease),
      border-color 0.45s,
      box-shadow 0.45s;
  }

  .mcard-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    background: #f9fafa;
    border-bottom: 1px solid #eceef0;
  }

  .mcard-head :global(.glyph) {
    width: 13px;
    height: 13px;
    color: #686f76;
    flex: none;
  }

  .mkind {
    font-size: 10.5px;
    color: #7c848b;
    font-weight: 500;
    flex: none;
  }

  .mtitle {
    font-size: 12px;
    font-weight: 580;
    color: #1c1f22;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mcard-body {
    padding: 9px 11px;
  }

  /* Card positions — intentionally cropped slightly at left/bottom on Step 0 to look like a live viewport slice */
  .mcard-dir {
    left: -18px;
    top: 26px;
    width: 232px;
  }

  .mcard-note {
    left: -10px;
    top: 186px;
    width: 224px;
  }

  .mcard-term {
    left: 6px;
    top: 320px;
    width: 228px;
  }

  .mcard-writer {
    left: 268px;
    top: 56px;
    width: 250px;
    border-color: #c9ced3;
  }

  .mcard-reviewer {
    left: 568px;
    top: 66px;
    width: 248px;
    border-color: #c9ced3;
    opacity: 0;
    transform: translateX(18px);
  }

  /* Directory tree */
  .mtree {
    display: grid;
    gap: 4px;
    font-family: var(--mono);
    font-size: 11px;
    color: #4f565d;
  }

  .mtree-row {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 2px 5px;
    border-radius: 4px;
    transition: background-color 0.4s, color 0.4s;
  }

  .mtree-indent {
    padding-left: 16px;
    color: #7b828a;
  }

  .mchev {
    font-size: 9px;
    color: #8a9198;
  }

  .mgit {
    margin-left: auto;
    font-size: 10px;
    color: #9a6700;
    font-weight: 600;
  }

  /* Note body */
  .mnote {
    display: grid;
    gap: 5px;
    font-size: 11.5px;
    color: #484f56;
  }

  .mnote-line {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .mbullet {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #8a9198;
    flex: none;
  }

  /* Terminal body */
  .mterm {
    display: grid;
    gap: 3px;
    font-family: var(--mono);
    font-size: 11px;
  }

  .mterm code {
    color: #202020;
    font-family: inherit;
  }

  .mterm-dim {
    color: #868d95;
    font-size: 10.5px;
  }

  /* Status & Unlinked badges */
  .mbadge {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1.5px 6px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 520;
    background: #eff1f2;
    color: #555c63;
  }

  .mdot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #7c848b;
    transition: background-color 0.35s;
  }

  .mstatus-work {
    display: none;
  }

  .mbadge-unlinked {
    opacity: 0;
    background: #f3f4f5;
    color: #8a9198;
    border: 1px dashed #cfd4d8;
    transition: opacity 0.4s;
  }

  /* Conversation inside Agent cards */
  .mconv {
    display: grid;
    gap: 7px;
  }

  .mmsg-user {
    justify-self: end;
    max-width: 92%;
    padding: 6px 9px;
    border-radius: 9px 9px 3px 9px;
    background: #eff1f3;
    color: #202020;
    font-size: 11.5px;
  }

  /* ToolHeader pill matching packages/ui/src/tool-header.tsx */
  .mtool {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 7px;
    border-radius: 6px;
    background: #f7f8f9;
    border: 1px solid #eaeced;
    font-size: 10.5px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
  }

  .mtool-op {
    font-weight: 560;
    color: #202020;
  }

  .mtool-sub {
    padding: 0.5px 5px;
    border-radius: 4px;
    background: #eceef0;
    color: #586068;
    font-size: 10px;
  }

  .mtool-arg {
    font-family: var(--mono);
    font-size: 10px;
    color: #6b727a;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mmsg-agent {
    font-size: 11.5px;
    color: #2c3136;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
  }

  /* Incoming Agent message surface (--external-message token from renderer/styles.css) */
  .mmsg-incoming {
    padding: 7px 9px;
    border-radius: 8px;
    background: #f4f0fe;
    color: #2f265f;
    border: 1px solid #e6defc;
    font-size: 11px;
  }

  .mincoming-head {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    font-weight: 600;
    margin-bottom: 3px;
    opacity: 0.82;
  }

  .mincoming-head :global(.glyph) {
    width: 11px;
    height: 11px;
  }

  .mmsg-incoming p {
    margin: 0;
    font-size: 11px;
    color: #2f265f;
    opacity: 1;
  }

  /* ==========================================================================
     Step-driven Choreography
     ========================================================================== */

  /* Step 1 (Links decide access):
     - Directed wires draw in from Directory & Note to Writer
     - Terminal recedes with dashed border + Unlinked pill
     - Writer switches to Working and invokes Read tool headers */
  .stage:is([data-step="1"], [data-step="2"]) .mwire-access .mwire-path {
    opacity: 1;
    stroke-dashoffset: 0;
  }

  .stage:is([data-step="1"], [data-step="2"]) .mwire-access .mwire-dot {
    opacity: 1;
  }

  .stage[data-step="1"] .mtree-active {
    background: #edf0f2;
    color: #181b1e;
  }

  .stage[data-step="1"] .mcard-term {
    opacity: 0.48;
    border-style: dashed;
    box-shadow: none;
  }

  .stage[data-step="1"] .mbadge-unlinked {
    opacity: 1;
  }

  .stage[data-step="1"] .mcard-writer .mdot {
    background: #202020;
  }

  .stage[data-step="1"] .mcard-writer .mstatus-ready {
    display: none;
  }

  .stage[data-step="1"] .mcard-writer .mstatus-work {
    display: inline;
  }

  .stage:is([data-step="1"], [data-step="2"]) .mtool-1 {
    opacity: 1;
    transform: none;
    transition-delay: 0.22s;
  }

  .stage:is([data-step="1"], [data-step="2"]) .mtool-2 {
    opacity: 1;
    transform: none;
    transition-delay: 0.36s;
  }

  .stage:is([data-step="1"], [data-step="2"]) .mcard-writer .mmsg-agent {
    opacity: 1;
    transform: none;
    transition-delay: 0.52s;
  }

  /* Step 2 (Independent contexts, explicit handoffs):
     - Viewport pans left to frame Writer -> Reviewer handoff
     - Reviewer card slides into focus with incoming message & independent verification read */
  .stage[data-step="2"] .mock-scene {
    translate: calc(-232px * var(--scene-scale, 0.96)) -50%;
  }

  .stage[data-step="2"] .mcard-dir,
  .stage[data-step="2"] .mcard-note,
  .stage[data-step="2"] .mcard-term {
    opacity: 0.35;
  }

  .stage[data-step="2"] .mcard-reviewer {
    opacity: 1;
    transform: none;
  }

  .stage[data-step="2"] .mwire-handoff .mwire-path {
    opacity: 1;
    stroke-dashoffset: 0;
    transition-delay: 0.2s;
  }

  .stage[data-step="2"] .mwire-handoff .mwire-dot {
    opacity: 1;
    transition-delay: 0.2s;
  }

  .stage[data-step="2"] .mtool-rev {
    opacity: 1;
    transform: none;
    transition-delay: 0.42s;
  }

  .stage[data-step="2"] .mmsg-rev {
    opacity: 1;
    transform: none;
    transition-delay: 0.6s;
  }

  /* Step 3 (Abstract branching history):
     - Mock viewport dissolves softly; abstract timeline draws in */
  .stage[data-step="3"] .mock-viewport {
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
  }

  .history-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.65s var(--ease);
  }

  .stage[data-step="3"] .history-stage {
    opacity: 1;
  }

  .trunk,
  .branch {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.95s var(--ease);
  }

  .branch {
    stroke: var(--ink);
    stroke-width: 1.65;
    transition-delay: 0.22s;
  }

  .commit {
