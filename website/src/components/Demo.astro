---
// One large, self-playing mock of the Asterism window. The layout follows the app (titlebar parts, docked sidebar,
// canvas island, object cards, docked panels); content is illustrative and does not track interface details.
import Icon from "./Icon.astro";
import MockCard from "./MockCard.astro";
import { content, type Locale } from "../i18n/content";
import { matches, stateAt } from "./demo-timeline";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].demo;
const u = t.ui;
const k = u.kinds;

// Server render the first frame of the script so the window is complete before the client takes over.
const initial = stateAt(0);
const on = (expr: string) => matches(expr, initial);
const mods = (rules: string) =>
  Object.fromEntries(
    rules.split(";").map(rule => {
      const at = rule.indexOf(":");
      return [rule.slice(0, at).trim(), on(rule.slice(at + 1))];
    }),
  );

const menuResources = [
  { icon: "folder", label: k.directory, id: "dir" },
  { icon: "file-text", label: k.note, id: "note" },
  { icon: "square-terminal", label: k.terminal, id: "term" },
  { icon: "globe", label: k.web },
  { icon: "server", label: k.mcp },
  { icon: "boxes", label: k.pool },
  { icon: "list-todo", label: k.todo },
  { icon: "book-open", label: k.manual },
] as const;

const accessRows = [
  { icon: "folder", title: "~/asterism", kind: k.directory, state: "link-dir", cursor: "sw-dir" },
  { icon: "file-text", title: u.noteTitle, kind: k.note, state: "link-note", cursor: "sw-note" },
  { icon: "square-terminal", title: "zsh", kind: k.terminal, state: "never", cursor: undefined },
] as const;

const readSel = "read:tool1 !tool1-done, rtool !rtool-done";
---

<section class="demo" data-demo aria-label={t.label}>
  <div class="wrap demo-head">
    <ol class="chapters" role="list">
      {
        t.chapters.map((chapter, index) => (
          <li>
            <button type="button" class:list={["chapter", { "is-active": index === 0 }]} data-chapter={index} aria-current={index === 0 ? "step" : undefined}>
              <span class="chapter-bar"><span /></span>
              <span class="chapter-num">0{index + 1}</span>
              <span class="chapter-title">{chapter.title}</span>
              <span class="chapter-body">{chapter.body}</span>
            </button>
          </li>
        ))
      }
    </ol>
    <button type="button" class="play" data-play data-label-pause={u.pause} data-label-play={u.play} aria-label={u.pause}>
      <span class="play-pause"><Icon name="pause" size={14} /></span>
      <span class="play-play"><Icon name="play" size={14} /></span>
    </button>
  </div>

  <div class="stage-wrap wrap">
    <div class="stage" data-stage role="img" aria-label={t.label}>
      <div class:list={["m-window", mods("fade:fade")]} data-window data-class="fade:fade" aria-hidden="true">
        <span class="m-lights"><i /><i /><i /></span>

        <!-- Titlebar: navigation part and actions part -->
        <header class="m-titlebar">
          <div class="m-part m-nav">
            <span class="m-ib"><Icon name="panel-left" /></span>
            <span class="m-btn m-app"><span class="m-asterism">⁂</span><b>Asterism</b><Icon name="chevron-down" class="m-dim" /></span>
            <span class="m-sep" />
            <span class="m-session-title">{u.sessionTitle}</span>
          </div>
          <div class="m-part m-actions">
            <span class="m-add">
              <span class:list={["m-btn", mods("pressed:menu")]} data-class="pressed:menu" data-cursor="add"><Icon name="plus" />{u.add}<Icon name="chevron-down" class="m-dim" /></span>
              <div class:list={["m-menu fade", { "is-on": on("menu") }]} data-show="menu">
                <p class="m-menu-label">{u.menuAgents}</p>
                <span class:list={["m-menu-item", mods("hover:hover-agent")]} data-class="hover:hover-agent" data-cursor="menu-agent"><Icon name="bot" />{k.agent}…</span>
                <span class="m-menu-sep" />
                <p class="m-menu-label">{u.menuResources}</p>
                {
                  menuResources.map(item => (
                    <span
                      class:list={["m-menu-item", "id" in item && mods(`hover:hover-${item.id}`)]}
                      data-class={"id" in item ? `hover:hover-${item.id}` : undefined}
                      data-cursor={"id" in item ? `menu-${item.id}` : undefined}
                    >
                      <Icon name={item.icon} />
                      {item.label}…
                    </span>
                  ))
                }
              </div>
            </span>
            <span class="m-btn"><Icon name="layout-dashboard" />{u.layout}<Icon name="chevron-down" class="m-dim" /></span>
            <span class:list={["m-btn", mods("pressed:access")]} data-class="pressed:access" data-cursor="access"><Icon name="key-round" />{u.access}</span>
            <span class="m-btn"><Icon name="list-tree" />{u.objects}</span>
            <span class:list={["m-btn", mods("pressed:hist")]} data-class="pressed:hist" data-cursor="history"><Icon name="history" />{u.history}</span>
          </div>
        </header>

        <div class="m-main">
          <!-- Docked navigation -->
          <aside class="m-dock m-sidebar">
            <div class="m-side-head">
              <span class="m-side-brand"><span class="m-asterism">⁂</span>Asterism</span>
              <span class="m-ib"><Icon name="panel-left-close" /></span>
            </div>
            <span class="m-btn m-wide"><Icon name="house" />{u.home}</span>
            <div class="m-side-section">
              <span class="m-label">{u.conversations}</span>
              <span class="m-ib"><Icon name="folder-plus" /></span>
            </div>
            <div class="m-toggle"><span class="is-on">{u.folders}</span><span>{u.recent}</span></div>
            <div class="m-group">
              <Icon name="chevron-right" class="m-dim m-rot" />
              <i class="m-folder-dot" />
              <b>{u.folderName}</b>
              <span class="m-count">{u.sessions.length}</span>
            </div>
            <div class="m-nested">
              {
                u.sessions.map((title, index) => (
                  <span class:list={["m-row", { "is-selected": index === 0 }]}>
                    <Icon name="message-square" />
                    <span class="m-row-title">{title}</span>
                    {index === 0 && <i class:list={["m-live fade", { "is-on": on("working, rworking") }]} data-show="working, rworking" />}
                  </span>
                ))
              }
            </div>
            <div class="m-group">
              <Icon name="chevron-right" class="m-dim m-rot" />
              <Icon name="folder" class="m-dim" />
              <span class="m-dim m-grow">{u.noFolder}</span>
              <span class="m-count">{u.looseSessions.length}</span>
            </div>
            <div class="m-nested">
              {
                u.looseSessions.map(title => (
                  <span class="m-row">
                    <Icon name="message-square" />
                    <span class="m-row-title">{title}</span>
                  </span>
                ))
              }
            </div>
          </aside>

          <!-- Central canvas island -->
          <div class="m-canvas">
            <div class="m-world">
              <MockCard icon="folder" kind={k.directory} title="~/asterism" class:list={["m-dir fade", { "is-on": on("dir") }]} data-show="dir">
                <div class="m-tree">
                  <span><Icon name="chevron-right" class="m-dim" /><Icon name="folder" />docs</span>
                  <span><Icon name="chevron-right" class="m-dim" /><Icon name="folder" />packages</span>
                  <span><Icon name="chevron-down" class="m-dim" /><Icon name="folder-open" />src</span>
                  <span class="m-tree-in"><Icon name="chevron-right" class="m-dim" /><Icon name="folder" />main</span>
                  <span class="m-tree-in"><Icon name="chevron-right" class="m-dim" /><Icon name="folder" />renderer</span>
                  <span class:list={["m-tree-file", mods(readSel)]} data-class={readSel}><Icon name="file" />CHANGELOG.md<em>M</em></span>
                  <span class="m-tree-file"><Icon name="file" />package.json</span>
                </div>
              </MockCard>

              <MockCard icon="file-text" kind={k.note} title={u.noteTitle} class:list={["m-note fade", { "is-on": on("note") }]} data-show="note">
                <div class:list={["m-doc", mods("read:tool2 !tool2-done")]} data-class="read:tool2 !tool2-done">
                  <b>{u.noteHeading}</b>
                  <ul>{u.noteLines.map(line => <li>{line}</li>)}</ul>
                </div>
              </MockCard>

              <MockCard icon="square-terminal" kind={k.terminal} title="zsh" class:list={["m-term fade", { "is-on": on("term") }]} data-show="term">
                <div class="m-shell" data-cursor="term">
                  <div><span class="m-ps">~/asterism $</span> <span data-type="command" data-text="npm run build" /><i class:list={["m-caret fade", { "is-on": on("term-focus !term-out") }]} data-show="term-focus !term-out" /></div>
                  <div class:list={["flow", { "is-on": on("term-out") }]} data-show="term-out">
                    <div class="m-shell-dim">vite v7.4 building for production…</div>
                    <div><span class="m-shell-ok">✓</span> 2148 modules transformed.</div>
                    <div class="m-shell-dim">out/renderer ready in 6.21s</div>
                    <div><span class="m-ps">~/asterism $</span> <i class="m-caret is-on" /></div>
                  </div>
                </div>
              </MockCard>

              <MockCard icon="bot" kind={k.agent} title={u.writer} class="m-writer">
                <div class="m-agent">
                  <div class="m-timeline">
                    <p class:list={["m-empty fade", { "is-on": on("!prompt") }]} data-show="!prompt">{u.emptyConversation}</p>
                    <div class:list={["m-msg-user flow", { "is-on": on("prompt") }]} data-show="prompt">{u.prompt}</div>
                    <div class:list={["m-tool flow", { "is-on": on("tool1") }, mods("pending:tool1 !tool1-done")]} data-show="tool1" data-class="pending:tool1 !tool1-done">
                      <span class="m-tool-icon"><Icon name="loader-circle" class="m-spin" /><Icon name="file-text" class="m-done" /></span>
                      <b>{u.readText}</b><span class="m-badge">CHANGELOG.md</span><span class="m-tool-sum">~/asterism</span>
                    </div>
                    <div class:list={["m-tool flow", { "is-on": on("tool2") }, mods("pending:tool2 !tool2-done")]} data-show="tool2" data-class="pending:tool2 !tool2-done">
                      <span class="m-tool-icon"><Icon name="loader-circle" class="m-spin" /><Icon name="file-text" class="m-done" /></span>
                      <b>{u.readText}</b><span class="m-badge">{u.noteTitle}</span>
                    </div>
                    <p class:list={["m-reply flow", { "is-on": on("reply") }]} data-show="reply" data-type="reply" data-text={u.reply} />
                    <div class:list={["m-tool flow", { "is-on": on("wsend") }, mods("pending:wsend !wsend-done")]} data-show="wsend" data-class="pending:wsend !wsend-done">
                      <span class="m-tool-icon"><Icon name="loader-circle" class="m-spin" /><Icon name="send" class="m-done" /></span>
                      <b>{u.send}</b><span class="m-badge">{u.reviewer}</span>
                      <span class:list={["m-tool-meta fade", { "is-on": on("wsend-done") }]} data-show="wsend-done">{u.accepted}</span>
                    </div>
                    <div class:list={["m-msg-agent flow", { "is-on": on("win") }]} data-show="win">
                      <span class="m-sender"><Icon name="bot" />{u.reviewer}</span>
                      <p>{u.review}</p>
                    </div>
                    <div class:list={["m-msg-user flow", { "is-on": on("b2prompt") }]} data-show="b2prompt">{u.followUp}</div>
                    <p class:list={["m-reply flow", { "is-on": on("b2reply") }]} data-show="b2reply" data-type="revised" data-text={u.revised} />
                    <p class:list={["m-status flow", { "is-on": on("working") }]} data-show="working"><Icon name="loader-circle" class="m-spinning" />{u.workingHint}</p>
                  </div>
                  <footer class="m-composer-wrap">
                    <div class="m-toolbar">
                      <span class="m-btn m-xs"><Icon name="bot" />{u.role}<Icon name="chevron-down" class="m-dim" /></span>
                      <span class="m-ring" />
                    </div>
                    <div class="m-composer" data-cursor="composer">
                      <p class="m-input">
                        <span class:list={["m-placeholder", { "is-hidden": on("c1, c2") }]} data-class="is-hidden:c1, c2">{u.placeholder}</span>
                        <span data-type="compose1" data-text={u.prompt} class:list={["fade", { "is-on": on("c1") }]} data-show="c1" />
                        <span data-type="compose2" data-text={u.followUp} class:list={["fade", { "is-on": on("c2") }]} data-show="c2" />
                      </p>
                      <div class="m-composer-bar">
                        <span class="m-ib"><Icon name="paperclip" /></span>
                        <span class="m-grow" />
                        <span class="m-btn m-xs"><Icon name="archive" />{u.saveDraft}</span>
                        <span class:list={["m-send", mods("ready:c1, c2")]} data-class="ready:c1, c2" data-cursor="send"><Icon name="arrow-up" /></span>
                      </div>
                    </div>
                  </footer>
                </div>
                <i class="m-port m-port-writer" data-cursor="writer-port" />
              </MockCard>

              <MockCard icon="bot" kind={k.agent} title={u.reviewer} class:list={["m-reviewer fade", { "is-on": on("rev") }]} data-show="rev">
                <div class="m-agent">
                  <div class="m-timeline">
                    <p class:list={["m-empty fade", { "is-on": on("!rin") }]} data-show="!rin">{u.emptyConversation}</p>
                    <div class:list={["m-msg-agent flow", { "is-on": on("rin") }]} data-show="rin">
                      <span class="m-sender"><Icon name="bot" />{u.writer}</span>
                      <p>{u.incoming}</p>
                    </div>
                    <div class:list={["m-tool flow", { "is-on": on("rtool") }, mods("pending:rtool !rtool-done")]} data-show="rtool" data-class="pending:rtool !rtool-done">
                      <span class="m-tool-icon"><Icon name="loader-circle" class="m-spin" /><Icon name="file-text" class="m-done" /></span>
                      <b>{u.readText}</b><span class="m-badge">CHANGELOG.md</span>
                    </div>
                    <p class:list={["m-reply flow", { "is-on": on("rreply") }]} data-show="rreply" data-type="review" data-text={u.review} />
                    <div class:list={["m-tool flow", { "is-on": on("rsend") }, mods("pending:rsend !rsend-done")]} data-show="rsend" data-class="pending:rsend !rsend-done">
                      <span class="m-tool-icon"><Icon name="loader-circle" class="m-spin" /><Icon name="send" class="m-done" /></span>
                      <b>{u.send}</b><span class="m-badge">{u.writer}</span>
                      <span class:list={["m-tool-meta fade", { "is-on": on("rsend-done") }]} data-show="rsend-done">{u.accepted}</span>
                    </div>
                  </div>
                  <footer class="m-composer-wrap">
                    <div class="m-toolbar">
                      <span class="m-btn m-xs"><Icon name="bot" />{u.role}<Icon name="chevron-down" class="m-dim" /></span>
                      <span class="m-ring" />
                    </div>
                    <div class="m-composer">
                      <p class="m-input"><span class="m-placeholder">{u.placeholder}</span></p>
                      <div class="m-composer-bar">
                        <span class="m-ib"><Icon name="paperclip" /></span>
                        <span class="m-grow" />
                        <span class="m-send"><Icon name="arrow-up" /></span>
                      </div>
                    </div>
                  </footer>
                </div>
                <i class="m-port m-port-rev" data-cursor="rev-port" />
              </MockCard>

              <!-- Links: source endpoint dot, line, and a solid head at the receiving end -->
              <svg class="m-links" viewBox="0 0 1038 750">
                <defs>
                  <marker id="m-head" viewBox="-10 -6 11 12" refX="0" refY="0" markerWidth="11" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                    <path d="M0 0 L-9 -4.95 Q-6.48 0 -9 4.95 Z" />
                  </marker>
                </defs>
                <g class:list={["m-link", { "is-on": on("link-dir") }]} data-show="link-dir">
                  <path d="M268 116 C296 116 290 170 304 170" pathLength="1" marker-end="url(#m-head)" />
                  <circle cx="268" cy="116" r="3.5" /><circle class="m-tip" cx="312" cy="170" r="3.5" />
                </g>
                <g class:list={["m-link", { "is-on": on("link-note") }]} data-show="link-note">
                  <path d="M268 344 C296 344 290 214 304 214" pathLength="1" marker-end="url(#m-head)" />
                  <circle cx="268" cy="344" r="3.5" /><circle class="m-tip" cx="312" cy="214" r="3.5" />
                </g>
                <g class:list={["m-link", { "is-on": on("link-rev") }]} data-show="link-rev">
                  <path d="M700 300 L732 300" pathLength="1" marker-start="url(#m-head)" marker-end="url(#m-head)" />
                  <circle class="m-tip" cx="688" cy="300" r="3.5" /><circle class="m-tip" cx="744" cy="300" r="3.5" />
                </g>
                <g class:list={["m-link", "m-link-late", { "is-on": on("link-dir-rev") }]} data-show="link-dir-rev">
                  <path d="M180 24 C180 8 196 8 230 8 L820 8 C872 8 880 30 880 98" pathLength="1" marker-end="url(#m-head)" />
                  <circle cx="180" cy="24" r="3.5" /><circle class="m-tip" cx="880" cy="106" r="3.5" />
                </g>
              </svg>
            </div>
          </div>

          <!-- Docked auxiliary panel -->
          <div class:list={["m-panel-slot", mods("open:access, hist")]} data-class="open:access, hist">
            <aside class="m-dock m-panel">
              <div class:list={["m-panel-view fade", { "is-on": on("access") }]} data-show="access">
                <header class="m-panel-head"><b>{u.accessTitle}</b><span class="m-ib"><Icon name="x" /></span></header>
                <div class="m-panel-body">
                  <div class="m-toggle"><span class="is-on">{u.byReceiver}</span><span>{u.byResource}</span></div>
                  <span class="m-label m-gap">{u.recipient}</span>
                  <span class="m-combo"><Icon name="bot" />{u.writer}<span class="m-grow" /><Icon name="chevron-down" class="m-dim" /></span>
                  <b class="m-h3">{u.canAccess}</b>
                  {
                    accessRows.map(row => (
                      <div class="m-access-row">
                        <Icon name={row.icon} class="m-dim" />
                        <div class="m-access-text">
                          <b>{row.title}</b>
                          <span class="m-caption">{row.kind}</span>
                          <span class:list={["m-state", mods(`linked:${row.state}`)]} data-class={`linked:${row.state}`}>
                            <span class="m-state-on"><Icon name="check" />{u.linked}</span>
                            <span class="m-state-off"><Icon name="link-2" />{u.notLinked}</span>
                          </span>
                        </div>
                        <span class:list={["m-switch", mods(`checked:${row.state}`)]} data-class={`checked:${row.state}`} data-cursor={row.cursor}><i /></span>
                      </div>
                    ))
                  }
                  <p class="m-caption m-boundary">{u.accessBoundary}</p>
                </div>
              </div>

              <div class:list={["m-panel-view fade", { "is-on": on("hist") }]} data-show="hist">
                <header class="m-panel-head m-tabs">
                  <span class:list={["m-tab", mods("active:!branch")]} data-class="active:!branch">{u.main}</span>
                  <span class:list={["m-tab flow-inline", { "is-on": on("branch") }, mods("active:branch")]} data-show="branch" data-class="active:branch">{u.branch}<Icon name="circle-dot" /></span>
                  <span class="m-grow" />
                  <span class="m-ib"><Icon name="x" /></span>
                </header>
                <div class="m-panel-body">
                  <div class="m-hist-tools">
                    <span class="m-combo"><Icon name="history" />{u.allRecords}<span class="m-grow" /><Icon name="chevron-down" class="m-dim" /></span>
                    <span class="m-ib m-ib-outline"><Icon name="search" /></span>
                  </div>
                  <div class="m-hist">
                    <span class="m-hrow m-hrow-start"><Icon name="history" class="m-dim" /><span>{u.sessionStart}</span></span>
                    <span class="m-hrow"><Icon name="message-square" class="m-dim" /><span><b>{u.prompt}</b><i>{u.you}</i></span></span>
                    <span class="m-hrow"><Icon name="file-text" class="m-dim" /><span><b>{u.readText} · CHANGELOG.md</b><i>{u.writer}</i></span></span>
                    <span class="m-hrow"><Icon name="file-text" class="m-dim" /><span><b>{u.readText} · {u.noteTitle}</b><i>{u.writer}</i></span></span>
                    <span class:list={["m-hrow", mods("selected:hsel")]} data-class="selected:hsel" data-cursor="hrow">
                      <Icon name="bot" class="m-dim" /><span><b>{u.reply}</b><i>{u.writer}</i></span>
                    </span>
                    <span class:list={["m-hcont flow", { "is-on": on("hsel") }]} data-show="hsel"><span class="m-btn m-xs m-outline" data-cursor="hcont"><Icon name="git-branch" />{u.continueHere}</span></span>
                    <span class:list={["m-hbranch flow", { "is-on": on("branch") }]} data-show="branch"><Icon name="git-branch" />{u.branchesHere}</span>
                    <span class:list={["m-hrow flow", { "is-on": on("!branch") }]} data-show="!branch"><Icon name="layers" class="m-dim" /><span><b>{u.reviewer}</b><i>{u.sessionSource}</i></span></span>
                    <span class:list={["m-hrow flow", { "is-on": on("!branch") }]} data-show="!branch"><Icon name="send" class="m-dim" /><span><b>{u.send} · {u.reviewer}</b><i>{u.writer}</i></span></span>
                    <span class:list={["m-hrow flow", { "is-on": on("!branch") }]} data-show="!branch"><Icon name="bot" class="m-dim" /><span><b>{u.review}</b><i>{u.reviewer}</i></span></span>
                    <span class:list={["m-hrow m-hrow-new flow", { "is-on": on("b2prompt") }]} data-show="b2prompt"><Icon name="message-square" class="m-dim" /><span><b>{u.followUp}</b><i>{u.you}</i></span></span>
                    <span class:list={["m-hrow m-hrow-new flow", { "is-on": on("b2reply") }]} data-show="b2reply"><Icon name="bot" class="m-dim" /><span><b>{u.revised}</b><i>{u.writer}</i></span><Icon name="circle-dot" class="m-cur" /></span>
                  </div>
                </div>
              </div>
            </aside>
          </div>
        </div>

        <span class="m-rest" data-cursor="rest" />
        <span class="m-cursor" data-pointer>
          <i class="m-cursor-ring" />
          <svg width="20" height="20" viewBox="0 0 20 20"><path d="M3.5 2.2v14.3l3.6-3.4 2.4 5.3 2.3-1-2.3-5.2h5z" /></svg>
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import { chapterAt, chapterStarts, cursorCues, loopLength, matches, stateAt, typing } from "./demo-timeline";

  const root = document.querySelector<HTMLElement>("[data-demo]");
  const stage = root?.querySelector<HTMLElement>("[data-stage]");
  const win = root?.querySelector<HTMLElement>("[data-window]");
  const pointer = root?.querySelector<HTMLElement>("[data-pointer]");
  const playButton = root?.querySelector<HTMLButtonElement>("[data-play]");

  if (root && stage && win && pointer && playButton) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const shows = [...win.querySelectorAll<HTMLElement | SVGElement>("[data-show]")].map(el => ({ el, expr: el.dataset.show! }));
    const classed = [...win.querySelectorAll<HTMLElement>("[data-class]")].map(el => ({
      el,
      rules: el.dataset.class!.split(";").map(rule => {
        const at = rule.indexOf(":");
        return [rule.slice(0, at).trim(), rule.slice(at + 1)] as const;
      }),
    }));
    const typed = [...win.querySelectorAll<HTMLElement>("[data-type]")].map(el => ({
      el,
      span: typing[el.dataset.type!],
      chars: Array.from(el.dataset.text ?? ""),
      shown: -1,
    }));
    const chapters = [...root.querySelectorAll<HTMLButtonElement>("[data-chapter]")];

    // Narrow stages crop the window to a 760px view and pan it to each chapter's working area.
    const viewWidth = 760;
    const cameraX = [214, 520, 520, 520];
    let scale = 1;
    let narrow = false;
    let time = 0;
    let lastKey = "";
    let lastChapter = -1;
    const aim = () => {
      const x = narrow ? cameraX[chapterAt(time)] : 0;
      win.style.translate = `${-x * scale}px 0`;
    };
    const fit = () => {
      narrow = stage.clientWidth < 720;
      stage.toggleAttribute("data-narrow", narrow);
      scale = stage.clientWidth / (narrow ? viewWidth : 1280);
      win.style.setProperty("--s", String(scale));
      aim();
    };
    new ResizeObserver(fit).observe(stage);
    fit();

    const render = () => {
      const state = stateAt(time);
      const key = [...state].sort().join(" ");
      if (key !== lastKey) {
        lastKey = key;
        shows.forEach(({ el, expr }) => el.classList.toggle("is-on", matches(expr, state)));
        classed.forEach(({ el, rules }) => rules.forEach(([name, expr]) => el.classList.toggle(name, matches(expr, state))));
      }
      typed.forEach(item => {
        const [start, duration] = item.span;
        const progress = Math.min(Math.max((time - start) / duration, 0), 1);
        const count = Math.round(progress * item.chars.length);
        if (count !== item.shown) {
          item.shown = count;
          item.el.textContent = item.chars.slice(0, count).join("");
        }
        item.el.classList.toggle("typing", progress > 0 && progress < 1);
      });
      const chapter = chapterAt(time);
      if (chapter !== lastChapter) {
        lastChapter = chapter;
        aim();
        chapters.forEach((button, index) => {
          button.classList.toggle("is-active", index === chapter);
          button.classList.toggle("is-past", index < chapter);
          if (index === chapter) button.setAttribute("aria-current", "step");
          else button.removeAttribute("aria-current");
        });
      }
      const end = chapterStarts[chapter + 1] ?? loopLength;
      chapters[chapter].style.setProperty("--p", String((time - chapterStarts[chapter]) / (end - chapterStarts[chapter])));
    };

    // Pointer: ease toward the current cue's target, measured every frame so moving panels and cards stay tracked.
    const cursor = { x: 1080, y: 640 };
    const cueAt = (t: number) => {
      let cue = cursorCues[0];
      for (const item of cursorCues) if (item[0] <= t) cue = item;
      return cue;
    };
    const targetPoint = (name: string) => {
      const el = win.querySelector<HTMLElement>(`[data-cursor="${name}"]`);
      if (!el) return null;
      const box = el.getBoundingClientRect();
      const frame = win.getBoundingClientRect();
      return { x: (box.left + box.width / 2 - frame.left) / scale, y: (box.top + box.height / 2 - frame.top) / scale };
    };
    const click = () => {
      pointer.classList.remove("is-click");
      void pointer.offsetWidth;
      pointer.classList.add("is-click");
    };
    const moveCursor = (dt: number, previous: number) => {
      const cue = cueAt(time);
      const target = targetPoint(cue[1]);
      if (target) {
        const k = dt < 0 ? 1 : 1 - Math.exp(-dt / 110);
        cursor.x += (target.x - cursor.x) * k;
        cursor.y += (target.y - cursor.y) * k;
        pointer.style.translate = `${cursor.x}px ${cursor.y}px`;
      }
      if (dt > 0) for (const [at, , pressed] of cursorCues) if (pressed && at > previous && at <= time) click();
    };

    let playing = false;
    let userPaused = reduced.matches;
    let visible = false;
    let frame = 0;
    let last = 0;
    const tick = (now: number) => {
      const dt = Math.min(now - last, 64);
      last = now;
      const previous = time;
      time += dt;
      if (time >= loopLength) {
        time = 0;
        lastKey = "";
      }
      render();
      moveCursor(time < previous ? -1 : dt, previous);
      frame = requestAnimationFrame(tick);
    };
    const sync = () => {
      const shouldPlay = visible && !userPaused;
      root.classList.toggle("is-paused", userPaused);
      playButton.setAttribute("aria-label", userPaused ? playButton.dataset.labelPlay! : playButton.dataset.labelPause!);
      if (shouldPlay === playing) return;
      playing = shouldPlay;
      if (playing) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      } else cancelAnimationFrame(frame);
    };

    // Paused playback shows the settled end of a chapter.
    const settle = (index: number) => {
      time = (chapterStarts[index + 1] ?? loopLength - 800) - 400;
      render();
      moveCursor(-1, time);
    };

    chapters.forEach((button, index) => {
      button.addEventListener("click", () => {
        if (userPaused) settle(index);
        else {
          time = chapterStarts[index];
          lastKey = "";
          render();
        }
      });
    });
    playButton.addEventListener("click", () => {
      userPaused = !userPaused;
      if (!userPaused && reduced.matches) time = chapterStarts[chapterAt(time)];
      sync();
    });

    new IntersectionObserver(
      entries => {
        visible = entries.some(entry => entry.isIntersecting);
        sync();
      },
      { threshold: 0.2 },
    ).observe(stage);

    if (userPaused) settle(2);
    else render();
    sync();
  }
</script>

