---
// Minimal 16px line glyphs for resource kinds and compact controls.
import type { GlyphName } from "../i18n/content";

interface Props {
  name: GlyphName;
}

const { name } = Astro.props;
---

<svg
  class="glyph"
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "agent" && (
    <>
      <circle cx="8" cy="8" r="5.5" />
      <circle cx="8" cy="8" r="1.6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === "note" && (
    <>
      <rect x="3" y="2.5" width="10" height="11" rx="1.5" />
      <path d="M5.5 6h5M5.5 8.5h5M5.5 11h3" />
    </>
  )}
  {name === "folder" && <path d="M2.5 4.5a1 1 0 0 1 1-1h2.8l1.4 1.5h4.8a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1z" />}
  {name === "terminal" && (
    <>
      <rect x="2" y="3" width="12" height="10" rx="1.5" />
      <path d="M5 6.5 7 8l-2 1.5M8.5 10h2.5" />
    </>
  )}
  {name === "pool" && (
    <>
      <circle cx="5" cy="5.5" r="2.25" />
      <circle cx="11.25" cy="5.5" r="2.25" />
      <circle cx="8.1" cy="11" r="2.25" />
      <path d="M6.8 6.8 7.3 9M9.5 6.8 8.9 9" />
    </>
  )}
  {name === "todo" && (
    <>
      <rect x="2.5" y="2.5" width="11" height="11" rx="2" />
      <path d="m5.3 8.1 1.8 1.8 3.6-3.8" />
    </>
  )}
  {name === "schedule" && (
    <>
      <circle cx="8" cy="8.5" r="5" />
      <path d="M8 6v2.7l1.8 1.1M6.2 2h3.6" />
    </>
  )}
  {name === "web" && (
    <>
      <circle cx="8" cy="8" r="5.5" />
      <ellipse cx="8" cy="8" rx="2.4" ry="5.5" />
      <path d="M2.7 8h10.6" />
    </>
  )}
  {name === "manual" && (
    <>
      <path d="M2.5 3.5h4.2a1.3 1.3 0 0 1 1.3 1.3v8.2a1 1 0 0 0-1-1H2.5z" />
      <path d="M13.5 3.5H9.3A1.3 1.3 0 0 0 8 4.8v8.2a1 1 0 0 1 1-1h4.5z" />
    </>
  )}
  {name === "copy" && (
    <>
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
      <path d="M10.5 5.5V3.8a1.3 1.3 0 0 0-1.3-1.3H3.8a1.3 1.3 0 0 0-1.3 1.3v5.4a1.3 1.3 0 0 0 1.3 1.3h1.7" />
    </>
  )}
  {name === "check" && <path d="M3.5 8.5 6.5 11.5 12.5 4.5" />}
</svg>
