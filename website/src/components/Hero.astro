---
import Glyph from "./Glyph.astro";
import { content, repoUrl, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].hero;

type Kind = "agent" | "note" | "folder" | "terminal";
interface Node {
  id: keyof typeof t.nodes;
  kind: Kind;
  // Board coordinates for the side-by-side layout and the stacked narrow layout.
  wide: [number, number];
  narrow: [number, number];
}

const nodes: Node[] = [
  { id: "notes", kind: "note", wide: [0, 44], narrow: [0, 0] },
  { id: "folder", kind: "folder", wide: [44, 236], narrow: [172, 92] },
  { id: "terminal", kind: "terminal", wide: [8, 430], narrow: [0, 344] },
  { id: "writer", kind: "agent", wide: [368, 196], narrow: [60, 214] },
  { id: "reviewer", kind: "agent", wide: [520, 420], narrow: [156, 452] },
];

// Directed links: resources are made available to the writer; the writer reports to the reviewer.
const links: [string, string][] = [
  ["notes", "writer"],
  ["folder", "writer"],
  ["terminal", "writer"],
  ["writer", "reviewer"],
];
---

<section class="hero">
  <div class="canvas" data-canvas>
    <div class="board" data-board role="img" aria-label={t.canvasLabel}>
      <svg class="wires" data-wires aria-hidden="true">
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1.5 1.5 8.5 5 1.5 8.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
        </defs>
        {links.map(([from, to]) => <path data-from={from} data-to={to} marker-end="url(#arrow)" pathLength="1" />)}
      </svg>
      {
        nodes.map((node, index) => (
          <div
            class:list={["card", `card-${node.kind}`]}
            data-node={node.id}
            data-wide={node.wide.join(",")}
            data-narrow={node.narrow.join(",")}
            style={`--i:${index}`}
          >
            <div class="card-head">
              <Glyph name={node.kind} />
              <span class="card-title">{t.nodes[node.id].title}</span>
            </div>
            <div class="card-meta">
              {node.id === "writer" && <span class="pulse" />}
              {node.kind === "terminal" ? <code>$ {t.nodes[node.id].meta}</code> : t.nodes[node.id].meta}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="wrap hero-copy">
    <h1>{t.lede.split("\n").map(line => <span>{line}</span>)}</h1>
    <div class="actions">
      <a class="button button-solid" href="#download">{t.download}</a>
      <a class="button button-ghost" href={repoUrl}>{t.source}</a>
    </div>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLElement>("[data-canvas]");
  const board = canvas?.querySelector<HTMLElement>("[data-board]");
  const wires = board?.querySelector<SVGSVGElement>("[data-wires]");
  const headline = document.querySelector<HTMLElement>(".hero h1");
  if (canvas && board && wires && headline) {
    // The arrangement is designed once per layout in fixed board units, then scaled to the free area.
    const sizes = { wide: [760, 560], narrow: [356, 530] } as const;
    const cards = new Map<string, HTMLElement>();
    const positions = new Map<string, [number, number]>();
    let layout: keyof typeof sizes = "wide";
    let scale = 1;

    board.querySelectorAll<HTMLElement>("[data-node]").forEach(card => cards.set(card.dataset.node!, card));

    const reset = (next: keyof typeof sizes) => {
      layout = next;
      canvas.dataset.layout = layout;
      const [w, h] = sizes[layout];
      board.style.width = `${w}px`;
      board.style.height = `${h}px`;
      wires.setAttribute("viewBox", `0 0 ${w} ${h}`);
      cards.forEach((card, id) => {
        const [x, y] = card.dataset[layout]!.split(",").map(Number);
        positions.set(id, [x, y]);
      });
    };

    // The side-by-side layout is used while the board can keep a readable scale beside the headline.
    const wideScale = () => {
      const [w, h] = sizes.wide;
      const gutter = parseFloat(getComputedStyle(headline.parentElement!).paddingLeft);
      const right = canvas.clientWidth - Math.min(gutter, 32);
      // Line boxes of the set text, not the element box, mark where the headline actually ends.
      const range = document.createRange();
      const textRight = Math.max(
        ...[...headline.querySelectorAll("span")].map(line => {
          range.selectNodeContents(line.firstChild!);
          return Math.max(...[...range.getClientRects()].map(rect => rect.right));
        }),
      );
      const free = right - (textRight - canvas.getBoundingClientRect().left) - 56;
      // Matches the hero's min-height so the decision does not depend on the layout it produces.
      const height = Math.min(52 * 16, innerHeight - 72);
      return { scale: Math.min(1, free / w, (height - 48) / h), right };
    };

    const fit = () => {
      const wide = wideScale();
      const next = wide.scale >= 0.62 ? "wide" : "narrow";
      if (next !== layout) {
        reset(next);
        place();
      }
      const [w, h] = sizes[layout];
      if (layout === "wide") {
        scale = wide.scale;
        board.style.translate = `${wide.right - w * scale}px ${(canvas.clientHeight - h * scale) / 2 + 12}px`;
      } else {
        const gutter = parseFloat(getComputedStyle(headline.parentElement!).paddingLeft);
        const width = canvas.clientWidth;
        scale = Math.min(1.1, (width - gutter * 2) / w);
        board.style.translate = `${(width - w * scale) / 2}px 32px`;
        canvas.style.setProperty("--board-height", `${h * scale + 64}px`);
      }
      board.style.scale = String(scale);
    };

    interface Box {
      x: number;
      y: number;
      w: number;
      h: number;
    }
    type Side = "left" | "right" | "top" | "bottom";

    const box = (id: string): Box => {
      const card = cards.get(id)!;
      const [x, y] = positions.get(id)!;
      return { x, y, w: card.offsetWidth, h: card.offsetHeight };
    };

    // Horizontally separated cards connect side to side; stacked cards connect top to bottom.
    const sides = (a: Box, b: Box): [Side, Side] => {
      if (b.x - (a.x + a.w) >= 24) return ["right", "left"];
      if (a.x - (b.x + b.w) >= 24) return ["left", "right"];
      return b.y > a.y ? ["bottom", "top"] : ["top", "bottom"];
    };

    const draw = () => {
      const ends: { id: string; side: Side; other: Box; set: (x: number, y: number) => void }[] = [];
      const paths = [...wires.querySelectorAll<SVGPathElement>("path[data-from]")].map(path => {
        const from = box(path.dataset.from!);
        const to = box(path.dataset.to!);
        const [fromSide, toSide] = sides(from, to);
        const wire = { path, fromSide, toSide, a: [0, 0], b: [0, 0] };
        ends.push({ id: path.dataset.from!, side: fromSide, other: to, set: (x, y) => (wire.a = [x, y]) });
        ends.push({ id: path.dataset.to!, side: toSide, other: from, set: (x, y) => (wire.b = [x, y]) });
        return wire;
      });

      // Wires sharing one side of a card are spread along it, ordered by where they come from.
      const groups = Map.groupBy(ends, end => `${end.id}:${end.side}`);
      groups.forEach(group => {
        const { id, side } = group[0];
        const card = box(id);
        const vertical = side === "left" || side === "right";
        group.sort((p, q) => (vertical ? p.other.y + p.other.h / 2 - (q.other.y + q.other.h / 2) : p.other.x - q.other.x));
        group.forEach((end, index) => {
          const t = (index + 1) / (group.length + 1);
          if (vertical) end.set(side === "left" ? card.x : card.x + card.w, card.y + card.h * (0.2 + 0.6 * t));
          else end.set(card.x + card.w * (0.2 + 0.6 * t), side === "top" ? card.y : card.y + card.h);
        });
      });

      const normal = { left: [-1, 0], right: [1, 0], top: [0, -1], bottom: [0, 1] } as const;
      paths.forEach(({ path, fromSide, toSide, a, b }) => {
        const [anx, any] = normal[fromSide];
        const [bnx, bny] = normal[toSide];
        const gap = 3;
        const bx = b[0] + bnx * gap;
        const by = b[1] + bny * gap;
        const bend = Math.max(28, Math.hypot(bx - a[0], by - a[1]) * 0.45);
        path.setAttribute(
          "d",
          `M${a[0]} ${a[1]}C${a[0] + anx * bend} ${a[1] + any * bend} ${bx + bnx * bend} ${by + bny * bend} ${bx} ${by}`,
        );
      });
    };

    const place = () => {
      cards.forEach((card, id) => {
        const [x, y] = positions.get(id)!;
        card.style.translate = `${x}px ${y}px`;
      });
      draw();
    };

    cards.forEach((card, id) => {
      card.addEventListener("pointerdown", event => {
        if (event.button !== 0) return;
        card.setPointerCapture(event.pointerId);
        card.classList.add("is-dragging");
        const [w, h] = sizes[layout];
        const [startX, startY] = positions.get(id)!;
        const move = (moveEvent: PointerEvent) => {
          const x = startX + (moveEvent.clientX - event.clientX) / scale;
          const y = startY + (moveEvent.clientY - event.clientY) / scale;
          positions.set(id, [Math.min(Math.max(x, 0), w - card.offsetWidth), Math.min(Math.max(y, 0), h - card.offsetHeight)]);
          place();
        };
        const end = () => {
          card.classList.remove("is-dragging");
          card.removeEventListener("pointermove", move);
          card.removeEventListener("pointerup", end);
          card.removeEventListener("pointercancel", end);
        };
        card.addEventListener("pointermove", move);
        card.addEventListener("pointerup", end);
        card.addEventListener("pointercancel", end);
      });
    });

    reset("wide");
    place();
    fit();
    addEventListener("resize", fit);
    document.fonts.ready.then(fit);
    canvas.classList.add("is-ready");
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(52rem, calc(100svh - 4.5rem));
    display: flex;
    flex-direction: column;
  }

  .hero-copy {
    position: relative;
    padding-top: clamp(3rem, 10vh, 7rem);
    pointer-events: none;
  }

  h1 {
    max-width: 10.5ch;
    font-size: clamp(2.75rem, 6.4vw, 5.75rem);
    line-height: 1.02;
    font-weight: 330;
    font-stretch: 112%;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  h1 span {
    display: block;
  }

  :global(html:lang(zh-CN)) h1 {
    max-width: none;
    font-size: clamp(2.5rem, 5.2vw, 4.75rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
    pointer-events: auto;
  }

  .canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-image: radial-gradient(circle, var(--grid) 1px, transparent 1.2px);
    background-size: 22px 22px;
    background-position: center;
    mask-image: radial-gradient(ellipse 85% 80% at 62% 48%, #000 50%, transparent 100%);
  }

  .board {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
  }

  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    color: var(--ink-3);
  }

  .wires path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .canvas.is-ready .wires path {
    animation: draw 1.1s var(--ease) forwards;
    animation-delay: 0.9s;
  }

  .canvas.is-ready .wires path:nth-of-type(2) {
    animation-delay: 1.05s;
  }

  .canvas.is-ready .wires path:nth-of-type(3) {
    animation-delay: 1.2s;
  }

  .canvas.is-ready .wires path:nth-of-type(4) {
    animation-delay: 1.5s;
  }

  .card {
    position: absolute;
    top: 0;
    left: 0;
    width: 216px;
    padding: 12px 14px 13px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    box-shadow: var(--shadow);
    cursor: grab;
    touch-action: none;
    user-select: none;
    opacity: 0;
    transition: box-shadow 0.25s, border-color 0.25s;
  }

  .canvas.is-ready .card {
    animation: rise 0.9s var(--ease) forwards;
    animation-delay: calc(0.15s + var(--i) * 0.09s);
  }

  .card:hover {
    border-color: var(--ink-3);
  }

  .card.is-dragging {
    cursor: grabbing;
    z-index: 2;
    border-color: var(--ink-2);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.04), 0 24px 48px -22px rgb(0 0 0 / 0.35);
  }

  .card-agent {
    width: 240px;
    border-radius: 20px;
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 540;
    font-stretch: 104%;
  }

  .card-head :global(.glyph) {
    color: var(--ink-2);
    flex: none;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.3rem;
    padding-left: 1.5rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-meta code {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .pulse {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--ink);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  .hero:has(.canvas[data-layout="narrow"]) {
    min-height: 0;
  }

  .canvas[data-layout="narrow"] {
    position: relative;
    inset: auto;
    order: 1;
    height: var(--board-height, 36rem);
    margin-top: 1.5rem;
    mask-image: radial-gradient(ellipse 95% 85% at 50% 50%, #000 60%, transparent 100%);
  }

  .canvas[data-layout="narrow"] .card {
    width: 184px;
  }

  .canvas[data-layout="narrow"] .card-agent {
    width: 200px;
  }

  @media (max-width: 52rem) {
    .hero-copy {
      padding-top: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
