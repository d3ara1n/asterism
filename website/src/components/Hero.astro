---
import { content, repoUrl, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].hero;
---

<section class="hero wrap">
  <h1>{t.lede}</h1>
  <p class="sublede">{t.sublede}</p>
  <div class="actions">
    <a class="button button-solid" href="#download">{t.download}</a>
    <a class="button button-ghost" href={repoUrl}>{t.source}</a>
  </div>
</section>

<style>
  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: clamp(3.5rem, 9vh, 6.5rem) clamp(2.75rem, 6vh, 4rem);
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    line-height: 1.02;
    font-weight: 330;
    font-stretch: 112%;
    letter-spacing: -0.035em;
    text-wrap: balance;
    animation: rise 0.9s var(--ease) both;
  }

  :global(html:lang(zh)) h1 {
    max-width: 12em;
    font-size: clamp(2.35rem, 4.8vw, 4.25rem);
    font-weight: 320;
    letter-spacing: -0.01em;
    line-height: 1.18;
  }

  .sublede {
    max-width: 34em;
    margin-top: 1.35rem;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    color: var(--ink-2);
    text-wrap: balance;
    animation: rise 0.9s 0.08s var(--ease) both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.1rem;
    animation: rise 0.9s 0.16s var(--ease) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
</style>
