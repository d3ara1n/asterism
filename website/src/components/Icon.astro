---
import { icons, type IconName, type IconNode } from "./icons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const nodes: IconNode = icons[name];
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {nodes.map(([Tag, attrs]) => <Tag {...attrs} />)}
</svg>
