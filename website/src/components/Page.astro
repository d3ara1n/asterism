---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Demo from "./Demo.astro";
import Resources from "./Resources.astro";
import Plugins from "./Plugins.astro";
import Principles from "./Principles.astro";
import Download from "./Download.astro";
import Footer from "./Footer.astro";
import type { Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Demo locale={locale} />
    <Resources locale={locale} />
    <Plugins locale={locale} />
    <Principles locale={locale} />
    <Download locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
