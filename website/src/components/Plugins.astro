---
import { content, sdkUrl, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].plugins;
const d = t.diagram;
---

<section id="plugins" class="plugins wrap">
  <div class="copy">
    <h2>{t.title}</h2>
    <p>{t.body}</p>
    <div class="links">
      <a class="more" href={sdkUrl}>{t.sdkLink}</a>
    </div>
  </div>

  <div class="diagram">
    <div class="slot slot-builtin">
      <div class="slot-head">
        <strong>{d.builtinTitle}</strong>
        <span>{d.builtinTag}</span>
      </div>
      <ul>
        {d.builtinItems.map(item => <li>{item}</li>)}
      </ul>
    </div>

    <div class="slot slot-yours">
      <div class="slot-head">
        <strong>{d.yoursTitle}</strong>
        <span>{d.yoursTag}</span>
      </div>
      <ul>
        {d.yoursItems.map(item => <li>{item}</li>)}
      </ul>
    </div>

    <div class="sdk-bar">
      <code>{d.sdkLayer}</code>
    </div>

    <div class="host">
      <strong>{d.hostTitle}</strong>
      <ul>
        {d.hostItems.map(item => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .plugins {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: linear-gradient(var(--line), var(--line)) top center / calc(100% - var(--gutter) * 2) 1px no-repeat;
  }

  h2 {
    font-size: clamp(2rem, 3.8vw, 3.35rem);
    line-height: 1.04;
    font-weight: 340;
    font-stretch: 110%;
    letter-spacing: -0.03em;
  }

  :global(html:lang(zh)) h2 {
    letter-spacing: 0;
    line-height: 1.25;
  }

  p {
    max-width: 28em;
    margin-top: 1.2rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .more {
    font-family: var(--mono);
    font-size: 0.84375rem;
    font-weight: 500;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.2rem;
    transition: border-color 0.2s;
  }

  .more:hover {
    border-color: var(--ink);
  }

  .diagram {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.65rem;
  }

  .slot {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.35rem;
    padding: 1.15rem 1.2rem;
    border-radius: 1rem;
  }

  .slot-builtin {
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .slot-yours {
    border: 1px dashed var(--ink-3);
    background: color-mix(in srgb, var(--surface) 45%, transparent);
  }

  .slot-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 0.75rem;
  }

  .slot-head strong {
    font-size: 1rem;
    font-weight: 560;
    font-stretch: 105%;
  }

  .slot-builtin .slot-head strong {
    font-family: var(--mono);
    font-size: 0.9375rem;
  }

  .slot-head span {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .slot ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.84375rem;
    color: var(--ink-2);
  }

  .sdk-bar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    text-align: center;
  }

  .sdk-bar code {
    font-family: var(--mono);
    font-size: 0.78125rem;
    color: var(--ink-2);
  }

  .host {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 1.05rem 1.25rem;
    border-radius: 1rem;
    background: var(--ink);
    color: var(--bg);
  }

  .host strong {
    font-size: 0.96875rem;
    font-weight: 540;
    font-stretch: 106%;
  }

  .host ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--bg) 72%, transparent);
  }

  .host li + li::before {
    content: "·";
    margin-right: 0.9rem;
    opacity: 0.5;
  }

  @media (max-width: 56rem) {
    .plugins {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .diagram {
      grid-template-columns: 1fr;
    }
  }
</style>
