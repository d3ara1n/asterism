{
  "name": "asterism-example-counter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "asterism-plugin-build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@asterism-app/sdk": "*",
    "react": "^19.3.0",
    "react-intl": "^12.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@asterism-app/sdk": "1.13.2",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@asterism-app/plugin-build": "0.1.0"
  },
  "asterism": {
    "id": "example.counter",
    "displayName": "Example counter",
    "manual": [
      "docs"
    ],
    "build": {
      "runtime": "src/runtime.ts",
      "storage": "src/storage.ts",
      "renderer": "src/renderer.tsx",
      "public": {
        "runtime": [
          "asterism-example-counter/contracts"
        ],
        "renderer": [
          "asterism-example-counter/contracts"
        ]
      }
    }
  },
  "exports": {
    "./contracts": "./src/contracts.ts"
  }
}
