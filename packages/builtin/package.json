{
  "name": "@asterism-app/builtin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./runtime": "./src/runtime.ts",
    "./storage": "./src/storage.ts",
    "./renderer": "./src/renderer.ts",
    "./locales/zh-Hans.json": "./src/locales/zh-Hans.json"
  },
  "dependencies": {
    "@asterism-app/builtin-api": "*",
    "@asterism-app/sdk": "*",
    "@asterism-app/ui": "*",
    "@lobehub/streamdown": "1.4.4",
    "@pierre/diffs": "1.6.2",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "exa-js": "2.26.0",
    "lucide-react": "1.64.0",
    "mermaid": "12.2.0",
    "motion": "14.7.1",
    "nanoid": "6.0.2",
    "parallel-web": "1.3.7",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sonner": "2.0.8",
    "virtua": "0.54.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.5"
  },
  "author": "Asterism",
  "asterism": {
    "id": "asterism.builtin",
    "runtime": "src/runtime.ts",
    "renderer": "src/renderer.ts",
    "storage": "src/storage.ts",
    "displayName": {
      "owner": "asterism.builtin",
      "id": "plugin.name",
      "defaultMessage": "Asterism Essentials",
      "kind": "message",
      "sourceLocale": "en"
    },
    "description": {
      "owner": "asterism.builtin",
      "id": "plugin.description",
      "defaultMessage": "Agents, conversations, notes, files and interactive tools.",
      "kind": "message",
      "sourceLocale": "en"
    },
    "i18n": {
      "catalogs": {
        "zh-Hans": "src/locales/zh-Hans.json"
      }
    },
    "publicPackages": [
      "@asterism-app/builtin-api"
    ],
    "runtimeExternals": [
      "@vscode/ripgrep"
    ]
  }
}
