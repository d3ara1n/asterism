      "kind": "message",
      "sourceLocale": "en"
    },
    "i18n": {
      "catalogs": {
        "zh-Hans": "src/locales/zh-Hans.json"
      }
    },
    "publicPackages": [
      "@asterism-app/builtin-api"
    ],
    "runtimeExternals": [
      "@vscode/ripgrep",
      "@parcel/watcher"
    ]
