{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": ["packages/sdk/src", "packages/sdk/examples", "src/shared", "src/runtime", "src/main", "src/preload", "src/session", "src/execution", "src/resources", "src/tools", "src/model", "src/configuration", "src/modules/*/runtime.ts", "*.config.ts"]
}
